GET {{URI}}/2

###
POST {{URI}}
Content-Type: application/json; charset=utf-8

     {
      "logradouro": "Jose Bonifacio",
      "tipo" : "rua"
    }

###
PUT {{URI}}/2
Content-Type: application/json; charset=utf-8

  {
      "logradouro": "Carlos Chagas Filho"
  }


